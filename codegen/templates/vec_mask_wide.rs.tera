// Generated from {{template_path}} template. Edit the template, not the generated file.

{% if scalar_t == "bool" %}
    {% set self_t = "BVec" ~ dim ~ "X4" %}
    {% set align = 1 %}
    {% set is_bool = true %}
{% else %}
    {% set self_t = "BVec" ~ dim ~ "AX4" %}
    {% if dim == 4 %}
        {% set vec_t = "Vec4X4" %}
    {% elif dim == 3 %}
        {% set vec_t = "Vec3X4" %}
    {% endif %}
    {% set align = 16 %}
    {% set is_u32 = true %}
    {% if is_sse2 %}
        {% set simd_t = "__m128" %}
    {% endif %}
{% endif %}

{% set components = ["x", "y", "z", "w"] | slice(end = dim) %}

use core::fmt;
use core::ops::*;

{% if is_sse2 %}
#[cfg(target_arch = "x86")]
use core::arch::x86::*;
#[cfg(target_arch = "x86_64")]
use core::arch::x86_64::*;
{% elif is_wasm32 %}
use core::arch::wasm32::*;
{% elif is_neon %}
use core::arch::aarch64::*;
{% elif is_coresimd %}
use core::simd::*;
{% endif %}

{% if is_sse2 %}
#[repr(C)]
union UnionCast {
    a: [u32; 4],
    v: {{ simd_t }}
}
{% endif %}

#[inline(always)]
#[must_use]
pub const fn {{ self_t | lower }}(
    {% for c in components %}
        {{ c }}: [bool; 4],
    {% endfor %}
) -> {{ self_t }} {
    {{ self_t }}::new({{ components | join(sep=",") }})
}

{%- if is_scalar or is_bool %}
#[derive(Clone, Copy, PartialEq, Eq, Hash)]
{%- else %}
#[derive(Clone, Copy)]
{%- endif %}
{%- if is_scalar %}
#[repr(C, align({{ align }}))]
pub struct {{ self_t }}
{
{% for c in components %}
    pub {{ c }}: {{ scalar_t }},
{%- endfor %}
}
{%- else %}
pub struct {{ self_t }} {
    {% for c in components %}
    pub(crate) {{ c }}: {{ simd_t }},
    {%- endfor %}
}
{% endif %}

const MASK: [u32; 2] = [0, 0xff_ff_ff_ff];

impl {{ self_t }} {
    #[inline(always)]
    #[must_use]
    pub const fn new(
        {% for c in components %}
            {{ c }}: [bool; 4],
        {% endfor %}
    ) -> Self {
        {% if is_scalar and is_bool %}
            Self {
                {% for c in components %}
                    {{ c }},
                {%- endfor %}
            }
        {% elif is_scalar and is_u32 %}
            Self {
                {% for c in components %}
                    {{ c }}: [
                        {% for i in range(end = 4) %}
                        MASK[{{ c }}[i] as usize],
                        {%- endfor %}
                    ],
                {%- endfor %}
            }
        {% elif is_sse2 %}
        Self {
            {% for c in components %}
            {{ c }}: unsafe { UnionCast { a: [
                {% for i in range(end = 4) %}
                MASK[{{ c }}[{{ i }}] as usize],
                {%- endfor %}
            ] }.v },
            {%- endfor %}
        }
        {% endif %}
    }
}
